#!/bin/sh
set -e
reload_users() {
    for dir in /run/user/*; do
        uid=${dir##*/}
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        name=$(id -nu "$uid" 2>/dev/null) || continue
        systemctl --user --machine="$name@.host" daemon-reload 2>/dev/null || true
    done
}
if [ "$1" = configure ]; then
    reload_users
    systemctl daemon-reload 2>/dev/null || true
    udevadm control --reload 2>/dev/null || true
    # Wi-Fi follows a USB adapter by default; "off" in the quick panel removes this file.
    if [ -z "$2" ] || dpkg --compare-versions "$2" lt 0.2.0; then
        mkdir -p /etc/ground0 && : > /etc/ground0/wifi-follow
    fi
    systemctl --no-block start ground0-wifi.service 2>/dev/null || true
    # Join a known network again when a reconnect fails (every minute).
    systemctl enable --now ground0-wifi-keep.timer >/dev/null 2>&1 || true
    # Power saving off takes effect the next time Wi-Fi connects; nothing is
    # disconnected here, so an install over SSH is not cut off.
    nmcli general reload conf >/dev/null 2>&1 || true
    # The launcher is not restarted here: it may be the program running this install.
    echo "Ground0 is installed. It takes over at the next boot, or now with: ground0 on"
fi
