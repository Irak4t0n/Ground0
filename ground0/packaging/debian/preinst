#!/bin/sh
set -e
# Ground0 takes the launcher's path; the stock launcher moves aside and keeps
# receiving its own package updates there.
if [ "$1" = install ] || [ "$1" = upgrade ]; then
    dpkg-divert --package ground0 --add --rename \
        --divert /usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch.stock \
        /usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch
fi
